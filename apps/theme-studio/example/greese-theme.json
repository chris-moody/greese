{
  "tokens": {
    "color": {
      "primary": {
        "light": "lavender-600",
        "dark": "lavender-300"
      }
    },
    "radius": {
      "md": "12px"
    }
  },
  "motionDefaults": {},
  "components": {
    "Card": {
      "motion": {
        "enter": "fade-up",
        "distance": "0.75rem"
      }
    },
    "Dialog": {
      "motion": {
        "exit": "scale-out"
      }
    },
    "Button": {
      "styles": {
        "font-weight": "700"
      },
      "modifiers": {
        "outline": {
          "border-width": "2px"
        }
      }
    },
    "ChatBubble": {
      "motion": {
        "enter": "fade-up",
        "delay": ".25s"
      }
    },
    "Chip": {
      "motion": {
        "enter": "fade-in"
      }
    }
  }
}
