{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4310 --strictPort",
    "check-types": "tsc --noEmit",
    "lint": "eslint src e2e bench --max-warnings 0",
    "test:e2e": "playwright test",
    "bench": "npm run build && node bench/run.ts"
  },
  "dependencies": {
    "@sauce-ui/react": "0.0.0",
    "@sauce-ui/tokens": "0.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@playwright/test": "^1.64.1",
    "@sauce-ui/eslint-config": "*",
    "@sauce-ui/typescript-config": "*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
