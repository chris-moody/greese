{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4330 --strictPort",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts server e2e --max-warnings 0",
    "stats": "node scripts/stats.ts",
    "themes": "node scripts/build-themes.ts",
    "lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@greese/react": "*",
    "@greese/ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@greese/icons": "*"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@storybook/react": "^10.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "sass": "^1.105.2",
    "sass-embedded": "^1.105.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
