    "stats": "node scripts/stats.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@greese/react": "*",
    "@greese/ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
