{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4330 --strictPort",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts server e2e --max-warnings 0",
    "stats": "node scripts/stats.ts",
    "themes": "node scripts/build-themes.ts",
    "lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shots": "node scripts/template-shots.ts"
  },
  "dependencies": {
    "@greese/authoring": "*",
    "@greese/icons": "*",
    "@greese/react": "*",
    "@greese/ui": "*",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.2.0",
    "react-router": "~8.4.0"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@storybook/react": "^10.6.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "prism-react-renderer": "^2.4.1",
    "react-docgen-typescript": "^2.4.0",
    "react-hook-form": "^7.89.0",
    "react-live": "^4.1.8",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.2",
    "sass-embedded": "^1.105.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
