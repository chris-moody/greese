{
  "name": "@greese/react",
  "version": "1.0.0",
  "description": "Mobile-first, TypeScript-first React components, styled by @greese/ui: zero-runtime, CSS-variable theming.",
  "keywords": [
    "react",
    "react19",
    "components",
    "ui",
    "design-system",
    "css-variables",
    "responsive",
    "mobile-first",
    "accessible",
    "zero-runtime"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/greese.js"
  ],
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./greese": {
      "types": "./dist/greese.d.ts",
      "default": "./dist/greese.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "default": "./dist/svg/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json",
    "./component-styles.json": "./dist/component-styles.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.ts",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@greese/icons": "0.1.0",
    "@greese/js": "0.1.0",
    "@greese/svg": "0.1.0",
    "@greese/ui": "1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
