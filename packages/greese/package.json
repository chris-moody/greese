{
  "name": "@greese-ui/greese",
  "version": "0.0.0",
  "description": "greese.js: a tiny keyframe and timeline animation library for CSS, transforms, text and objects. Seekable, reversible, time-scaled and nestable.",
  "keywords": [
    "animation",
    "timeline",
    "keyframes",
    "tween",
    "css",
    "transform",
    "motion"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git",
    "directory": "packages/greese"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global": "./dist/greese.global.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/greese.global.js",
  "jsdelivr": "./dist/greese.global.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-global.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@greese-ui/eslint-config": "*",
    "@greese-ui/typescript-config": "*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
