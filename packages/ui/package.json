{
  "name": "@greese/ui",
  "version": "1.0.0",
  "description": "greese ui's CSS and design tokens: a framework-free stylesheet, per-component CSS, custom properties, Sass kit and TypeScript constants. Works in plain HTML, or under any framework.",
  "keywords": [
    "css",
    "design-system",
    "design-tokens",
    "css-variables",
    "theme",
    "dark-mode",
    "sass",
    "scss",
    "web-components",
    "framework-agnostic",
    "mobile-first"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "greese-utilities": "./bin/greese-utilities.mjs"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist",
    "src/styles",
    "src/components/**/*.scss",
    "themes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "default": "./dist/effects.js"
    },
    "./effect-classes": {
      "types": "./dist/effect-classes.d.ts",
      "default": "./dist/effect-classes.js"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "default": "./dist/utilities.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "default": "./dist/shapes.js"
    },
    "./utilities-files": {
      "types": "./dist/utilitiesFiles.d.ts",
      "default": "./dist/utilitiesFiles.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./utilities.css": "./dist/utilities.css",
    "./styles.css": "./dist/greese.css",
    "./base.css": "./dist/base.css",
    "./css/*": "./dist/css/*",
    "./tokens.css": "./dist/tokens.css",
    "./palette.css": "./dist/palette.css",
    "./themes/*": "./themes/*",
    "./scss": {
      "sass": "./src/styles/index.scss"
    },
    "./scss/kit": {
      "sass": "./src/styles/_kit.scss"
    },
    "./scss/config": {
      "sass": "./src/styles/_config.scss"
    },
    "./scss/mixins": {
      "sass": "./src/styles/public/_mixins.scss"
    },
    "./scss/tones": {
      "sass": "./src/styles/public/_tones.scss"
    },
    "./scss/floating": {
      "sass": "./src/styles/public/_floating.scss"
    },
    "./scss/controls": {
      "sass": "./src/styles/public/_controls.scss"
    },
    "./scss/tokens": "./dist/_tokens.scss",
    "./scss/layers": "./dist/_layers.scss",
    "./scss/maps": "./dist/_maps.scss",
    "./style-manifest.json": "./dist/style-manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-tokens.ts && node scripts/build-utilities.ts && node scripts/build-styles.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0 && stylelint \"src/**/*.scss\" --max-warnings 0",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.105.2",
    "size-limit": "^14.2.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
