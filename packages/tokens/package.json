{
  "name": "@greese-ui/tokens",
  "version": "1.0.0",
  "description": "Design tokens for GreeseUI as CSS custom properties, Sass maps, and TypeScript constants.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "theme",
    "dark-mode",
    "sass"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./palette.css": "./dist/palette.css",
    "./scss": "./dist/_tokens.scss",
    "./scss/layers": "./dist/_layers.scss",
    "./scss/maps": "./dist/_maps.scss",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@greese-ui/eslint-config": "*",
    "@greese-ui/typescript-config": "*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
