[
  {
    "name": "@greese/authoring/core: everything",
    "path": "dist/core/index.js",
    "import": "*",
    "limit": "3 kB"
  },
  {
    "name": "@greese/authoring/state: everything (RTK is a peer)",
    "path": "dist/state/index.js",
    "import": "*",
    "ignore": ["@reduxjs/toolkit"],
    "limit": "2 kB"
  },
  {
    "name": "@greese/authoring: PanelDock (peers and greese packages excluded)",
    "path": "dist/index.js",
    "import": "{ PanelDock, createAuthoringEnvironment }",
    "ignore": [
      "react",
      "react-dom",
      "react-redux",
      "@reduxjs/toolkit",
      "@greese/react",
      "@greese/icons"
    ],
    "limit": "6.4 kB"
  },
  {
    "name": "@greese/authoring/styles.css",
    "path": "dist/styles.css",
    "limit": "1.4 kB",
    "rolldown": false
  }
]
