{
  "name": "@greese/authoring",
  "version": "0.0.0",
  "description": "Editor UI for greese: docking panels, layout specs and per-editor Redux state, for building graphics, animation and sound authoring tools.",
  "keywords": [
    "editor",
    "authoring",
    "docking",
    "panels",
    "layout",
    "redux",
    "react"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git",
    "directory": "packages/authoring"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0 && stylelint \"src/**/*.scss\" --max-warnings 0",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "@greese/icons": "0.1.0",
    "@greese/react": "1.1.0",
    "@greese/ui": "1.1.0"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@reduxjs/toolkit": "^2.11.2",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.2.0",
    "sass-embedded": "^1.105.2",
    "size-limit": "^14.2.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
