{
  "name": "@sauce-ui/sauce",
  "version": "0.0.0",
  "description": "sauce.js: a tiny keyframe and timeline animation library for CSS, transforms, text and objects. Seekable, reversible, time-scaled and nestable.",
  "keywords": [
    "animation",
    "timeline",
    "keyframes",
    "tween",
    "css",
    "transform",
    "motion"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@sauce-ui/eslint-config": "*",
    "@sauce-ui/typescript-config": "*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
