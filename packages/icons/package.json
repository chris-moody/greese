{
  "name": "@greese/icons",
  "version": "0.1.0",
  "description": "A small set of line icons as React components, sized to text and colored by currentColor. Optional: greese ui takes any icons.",
  "keywords": [
    "icons",
    "react",
    "svg"
  ],
  "author": "Chris Moody",
  "license": "MIT",
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@greese/eslint-config": "*",
    "@greese/typescript-config": "*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
