{
  "name": "greese",
  "private": true,
  "homepage": "https://chris-moody.github.io/greese/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chris-moody/greese.git"
  },
  "bugs": {
    "url": "https://github.com/chris-moody/greese/issues"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prebuild": "node scripts/check-workspace-links.mjs",
    "build": "turbo run build",
    "predev": "node scripts/check-workspace-links.mjs",
    "dev": "turbo run dev watch",
    "studio": "npm run dev -w site",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "size": "turbo run size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "publish-packages": "turbo run build --filter=./packages/* && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,scss}\"",
    "prepare": "husky",
    "commitlint": "commitlint",
    "test:visual": "turbo run test:visual",
    "test:dashboard": "node tools/test-dashboard/server.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "check:links": "node scripts/check-workspace-links.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.11.9"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24"
  }
}
